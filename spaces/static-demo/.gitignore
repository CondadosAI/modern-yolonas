# The exported graph is a 46.5 MB build artifact, reproducible from released weights:
#   uv run yolonas export --model yolo_nas_s --format onnx \
#       --output spaces/static-demo/models/yolo-nas-s.onnx --opset 17
# It lives in the deployed Space, so git does not need to carry it. Drop this line
# if you would rather have the demo deployable straight from a fresh clone.
models/*.onnx

# Parity fixtures, regenerated by tests/make_fixtures.py (input.bin alone is 4.9 MB).
tests/input.bin
tests/meta.json
tests/reference.json

node_modules/
__pycache__/
*.pyc
